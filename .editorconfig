root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml,props,targets,csproj,slnx,xml}]
indent_size = 2

[*.{ps1,cmd}]
end_of_line = crlf

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
dotnet_diagnostic.IDE0161.severity = warning

csharp_prefer_braces = true:warning
csharp_preserve_single_line_statements = false
dotnet_diagnostic.IDE0011.severity = warning

dotnet_naming_rule.constants_are_upper_snake.symbols = constants
dotnet_naming_rule.constants_are_upper_snake.style = upper_snake
dotnet_naming_rule.constants_are_upper_snake.severity = warning
dotnet_naming_symbols.constants.applicable_kinds = field, local
dotnet_naming_symbols.constants.applicable_accessibilities = *
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_style.upper_snake.capitalization = all_upper
dotnet_naming_style.upper_snake.word_separator = _
dotnet_diagnostic.IDE1006.severity = warning
