      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "header, 192 bytes\n0 magic fetchidx   8 version   12 endian marker\n16 file length   24 xxhash3 of [32, end)\n32 built-at   40 entries, segments, roots, non-ascii\n56 section count   64 table: 8 x (offset, length)",
      "roughness": 1,
      "roundness": null,
      "seed": 248689753,
      "strokeColor": "#e8590c",
      "strokeStyle": "solid",
      "strokeWidth": 1,
      "text": "header, 192 bytes\n0 magic fetchidx   8 version   12 endian marker\n16 file length   24 xxhash3 of [32, end)\n32 built-at   40 entries, segments, roots, non-ascii\n56 section count   64 table: 8 x (offset, length)",
      "textAlign": "center",
      "updated": 1792506669043,
      "version": 1,
      "versionNonce": 1046530357,
      "verticalAlign": "middle"
    },
