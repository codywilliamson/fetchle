      "groupIds": [],
      "index": "aY",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "the parents column (0, 0, 1, 3) never decreases, so a dir's children are one\ncontiguous run, found with two binary searches.\n\nquery \"json\": scan the blob once and mark segment x.json. then one forward pass:\nan entry matches if its own name does, or its parent inside the scope already did.\nscore 1.0 for a name hit, 0.5 for a path-only hit, same as a live walk.",
      "roughness": 1,
      "roundness": null,
      "seed": 1793758765,
      "strokeColor": "#1e1e1e",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "the parents column (0, 0, 1, 3) never decreases, so a dir's children are one\ncontiguous run, found with two binary searches.\n\nquery \"json\": scan the blob once and mark segment x.json. then one forward pass:\nan entry matches if its own name does, or its parent inside the scope already did.\nscore 1.0 for a name hit, 0.5 for a path-only hit, same as a live walk.",
      "textAlign": "left",
      "updated": 1792506669046,
      "version": 1,
      "versionNonce": 1787485817,
      "verticalAlign": "top"
    },
    {
      "id": "mvgs6tpt8d48s4mqm8t-label",
      "type": "text",
      "x": 10,
      "y": 110,
      "width": 740,
      "height": 100,
      "angle": 0,
      "autoResize": true,
