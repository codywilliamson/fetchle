      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "File.Move gets access\ndenied while a reader\nmaps the old file. posix\nrename swaps it; the old\nview keeps its old bytes",
      "roughness": 1,
      "roundness": null,
      "seed": 1028342545,
      "strokeColor": "#e8590c",
      "strokeStyle": "solid",
      "strokeWidth": 2,
