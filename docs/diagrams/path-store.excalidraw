    {
      "id": "mvgs6tpt3sc18ugo44",
      "type": "text",
      "x": 560,
      "y": 956,
      "width": 837,
      "height": 128,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": null,
