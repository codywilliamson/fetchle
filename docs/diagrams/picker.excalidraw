      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "UI LOOP (XenoAtom TerminalApp, pretty mode only)\nTextBox focused explicitly (ctx.App.Focus)\nkey -> query state changes\n-> Submit(query), never waits\nup/down/pgup/pgdn move the selection\nenter prints the path (exit 0), esc/ctrl+c exit 1",
      "roughness": 1,
      "roundness": null,
      "seed": 802926464,
      "strokeColor": "#1971c2",
      "strokeStyle": "solid",
      "strokeWidth": 1,
      "text": "UI LOOP (XenoAtom TerminalApp, pretty mode only)\nTextBox focused explicitly (ctx.App.Focus)\nkey -> query state changes\n-> Submit(query), never waits\nup/down/pgup/pgdn move the selection\nenter prints the path (exit 0), esc/ctrl+c exit 1",
      "textAlign": "center",
