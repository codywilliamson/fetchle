      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "LatestWinsSearch, one pool worker\nSubmit: sequence++, cancel the running search,\n  replace whatever was waiting (no queue)\nworker: take the newest, search with prefix=true\n  (\"termi\" matches terminal)\npublish only if sequence == newest submitted\nsearches never overlap: one reader per session\nno debounce",
      "roughness": 1,
      "roundness": null,
      "seed": 1287317111,
      "strokeColor": "#e8590c",
      "strokeStyle": "solid",
      "strokeWidth": 1,
      "text": "LatestWinsSearch, one pool worker\nSubmit: sequence++, cancel the running search,\n  replace whatever was waiting (no queue)\nworker: take the newest, search with prefix=true\n  (\"termi\" matches terminal)\npublish only if sequence == newest submitted\nsearches never overlap: one reader per session\nno debounce",
      "textAlign": "center",
      "updated": 1792604977657,
