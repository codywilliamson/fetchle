      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "RRF, k = 60: sum of w / (60 + rank)\nlexical w 1; semantic w 0.75, or 0 when some candidate\nmatched every query word (lexical is confident)\nequal scores share a rank; ties break on the path\nno word matched anywhere and best cosine < 0.5 -> empty\nindexed + live-walked roots merge per retriever first",
      "roughness": 1,
      "roundness": null,
      "seed": 1717831206,
      "strokeColor": "#e8590c",
      "strokeStyle": "solid",
      "strokeWidth": 1,
      "text": "RRF, k = 60: sum of w / (60 + rank)\nlexical w 1; semantic w 0.75, or 0 when some candidate\nmatched every query word (lexical is confident)\nequal scores share a rank; ties break on the path\nno word matched anywhere and best cosine < 0.5 -> empty\nindexed + live-walked roots merge per retriever first",
      "textAlign": "center",
      "updated": 1792604944179,
      "version": 1,
      "versionNonce": 1820369586,
      "verticalAlign": "middle"
    },
