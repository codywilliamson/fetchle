<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- the windows lister reads ntdll buffers in place -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- xxhash3 checksums the snapshot -->
    <PackageReference Include="System.IO.Hashing" />
  </ItemGroup>
  <ItemGroup>
    <!-- the bench sweeps internal knobs like the walker's worker count, tests poke internal types -->
    <InternalsVisibleTo Include="Fetchle.Bench" />
    <InternalsVisibleTo Include="Fetchle.Evals" />
    <InternalsVisibleTo Include="Fetchle.Tests" />
  </ItemGroup>
</Project>
