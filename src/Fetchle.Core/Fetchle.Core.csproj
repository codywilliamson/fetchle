<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- the windows lister reads ntdll buffers in place -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- the bench sweeps internal knobs like the walker's worker count, tests poke internal types -->
    <InternalsVisibleTo Include="Fetchle.Bench" />
